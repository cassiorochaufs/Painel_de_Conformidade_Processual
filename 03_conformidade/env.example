# Copie este arquivo para .env e preencha somente no ambiente local.
# NUNCA publique o arquivo .env real.

# ---------------------------------------------------------------------------
# Origem dos dados tratados
# ---------------------------------------------------------------------------

# database: consulta a view configurada em DATABASE_VIEW.
# csv: lê o arquivo configurado em SOURCE_CSV.
SOURCE_MODE=database

# Use uma URL compatível com SQLAlchemy.
# Exemplo PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/banco
DATABASE_URL=
DATABASE_VIEW=vw_cessao

# Usado apenas quando SOURCE_MODE=csv.
SOURCE_CSV=

# Nomes das colunas na fonte tratada.
CASE_COLUMN=Processo
UNIT_COLUMN=Unidade
TIMESTAMP_COLUMN=Data_Inicio

# ---------------------------------------------------------------------------
# Referências analíticas
# ---------------------------------------------------------------------------

MAPPING_FILE=./config/mapeamento_unidades.xlsx
BPMN_FILE=./config/modelo_referencia.bpmn

# A Prova de Conceito utilizou a regra de classificação de unidades não
# explicitamente mapeadas como "UNIDADE DE ORIGEM". Revise esta regra antes
# de adaptar a solução a outro processo. Deixe vazio para exigir mapeamento
# explícito de todas as unidades.
UNMAPPED_ACTIVITY=UNIDADE DE ORIGEM

# Mantém a normalização aplicada na Prova de Conceito aos rótulos do modelo.
# Desative se o BPMN computável já possuir rótulos diretamente compatíveis.
STRIP_MODEL_PREPOSITIONS=true

# Limiar de priorização gerencial. Não é fronteira de conformidade.
FITNESS_ALERT_THRESHOLD=0.80

# Diretório estável consumido pela camada de visualização.
OUTPUT_DIR=./output
